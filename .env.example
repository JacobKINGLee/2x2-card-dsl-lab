# Select the server-side semantic model provider. Never expose API keys to client code.
SEMANTIC_MODEL_PROVIDER=huawei

# Huawei Cloud ModelArts MaaS (OpenAI-compatible Chat Completions)
HUAWEI_MAAS_API_KEY=
HUAWEI_MAAS_BASE_URL=https://api.modelarts-maas.com/openai/v1
HUAWEI_MAAS_MODEL=openpangu-2.0-flash

# Optional OpenAI fallback provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Qwen3-8B experiment: select SEMANTIC_MODEL_PROVIDER=aliyun
ALIYUN_MAAS_API_KEY=
ALIYUN_MAAS_BASE_URL=
ALIYUN_MAAS_MODEL=qwen3-8b
# v2 uses one frozen SemanticDocument prompt. This variable is only relevant
# when manually reproducing the preserved v1 request builder.
ALIYUN_MAAS_PROMPT_PROFILE=explicit-v1
