{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "demo:local": "vinext start --hostname 127.0.0.1 --port 3000",
    "demo:lan": "vinext start --hostname 0.0.0.0 --port 3000",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && npm run test:semantic",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:semantic": "node --import ./experiments/register-typescript.mjs --test experiments/legacy-scoring.test.mjs experiments/scoring.test.mjs tests/component-decision.test.mjs",
    "test:decision": "node --import ./experiments/register-typescript.mjs --test tests/component-decision.test.mjs",
    "eval:qwen": "node --env-file=.env.local --import ./experiments/register-typescript.mjs experiments/run.mjs --provider aliyun",
    "eval:local": "node --import ./experiments/register-typescript.mjs experiments/run.mjs --provider local",
    "eval:preflight": "node --import ./experiments/register-typescript.mjs experiments/run.mjs --provider aliyun --dataset experiments/independent-v2.mjs --label qwen-independent-v2 --preflight",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
